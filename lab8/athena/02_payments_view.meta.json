        "Query": "CREATE OR REPLACE VIEW lab8.payments AS\nWITH dedup_exact AS (\n  SELECT DISTINCT *\n  FROM lab8.payment_events\n),\nranked AS (\n  SELECT\n    *,\n    row_number() OVER (\n      PARTITION BY invoiceId\n      ORDER BY from_iso8601_timestamp(modifiedDate) DESC\n    ) AS rn\n  FROM dedup_exact\n)\nSELECT\n  invoiceId,\n  status,\n  failureReason,\n  amount,\n  finalAmount,\n  ccy,\n  reference,\n  createdDate,\n  modifiedDate,\n  receivedAt,\n  merchantId,\n  merchantName,\n  mcc,\n  customerId,\n  paymentMethod,\n  device,\n  dt\nFROM ranked\nWHERE rn = 1",
